macro_rules! diga {
    () => {
        println!();
    };

    (? $head:expr, $($tail:tt)*) => {
        print!("{:?} ", $head);    
        diga!($($tail)*);  
    };

    (? $head:expr) => {
        println!("{:?}", $head);
    };

    ($head:expr, $($tail:tt)*) => {
        print!("{} ", $head);      
        diga!($($tail)*);  
    };

    ($head:expr) => {
        println!("{}", $head)
    };
}
